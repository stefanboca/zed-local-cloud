use axum::{
    extract::Query,
    http::{HeaderMap, Method, StatusCode, Uri},
    response::{IntoResponse, Redirect},
};
use axum_login::{
    AuthManagerLayerBuilder,
    tower_sessions::{CachingSessionStore, SessionManagerLayer},
};
use base64::prelude::*;
use rsa::{Oaep, RsaPublicKey, pkcs1::DecodeRsaPublicKey as _, sha2::Sha256};
use sqlx::SqlitePool;
use tower_sessions_moka_store::MokaStore;
use tower_sessions_sqlx_store::SqliteStore;

mod auth;
mod routes;

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    let db = SqlitePool::connect(":memory:").await?;
    sqlx::migrate!().run(&db).await?;

    let moka_store = MokaStore::new(Some(4096));
    let db_store = SqliteStore::new(db.clone());
    let session_store = CachingSessionStore::new(moka_store, db_store);
    let session_layer = SessionManagerLayer::new(session_store);

    let backend = auth::Backend::new(db, _, _, _, _);
    let auth_layer = AuthManagerLayerBuilder::new(backend, session_layer).build();

    let app = routes::router().layer(auth_layer);
    // let app = axum::Router::new()
    //     .route("/native_app_signin", get(native_app_signin))
    //     .route(
    //         "/native_app_signin_succeeded",
    //         get(native_app_signin_succeeded),
    //     )
    //     .fallback(fallback)
    //     .layer(auth_layer);

    let listener = tokio::net::TcpListener::bind("127.0.0.1:3333").await?;
    axum::serve(listener, app).await?;

    Ok(())
}

#[derive(Debug, serde::Deserialize)]
struct NativeAppSigninQuery {
    native_app_port: u16,
    native_app_public_key: String,
}

async fn native_app_signin(Query(params): Query<NativeAppSigninQuery>) -> impl IntoResponse {
    let NativeAppSigninQuery {
        native_app_port,
        native_app_public_key,
    } = params;

    let pubkey = {
        let bytes = BASE64_URL_SAFE.decode(native_app_public_key).unwrap();
        RsaPublicKey::from_pkcs1_der(&bytes).unwrap()
    };

    let user_id = 42u64;
    let access_token = {
        let bytes = b"token";
        let mut rng = rand::thread_rng();
        let enc = pubkey
            .encrypt(&mut rng, Oaep::new::<Sha256>(), bytes)
            .unwrap();
        BASE64_URL_SAFE.encode(enc)
    };

    Redirect::to(&format!(
        "http://localhost:{native_app_port}/signin?user_id={user_id}&access_token={access_token}"
    ))
}

async fn native_app_signin_succeeded() -> impl IntoResponse {
    "Succeeded"
}

async fn fallback(method: Method, uri: Uri, headers: HeaderMap) -> impl IntoResponse {
    eprintln!("unhandled route: method={method:?} uri={uri:?}");
    if let Some(authorization) = headers.get("Authorization") {
        eprintln!("\tauthorization={authorization:?}");
    }
    StatusCode::INTERNAL_SERVER_ERROR
}
